---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'As moedas do mundo, vistas de onde você está. Cotações ao vivo, câmbio cruzado, conversor e alertas de preço.',
} = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ECEFE8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://api.frankfurter.dev" crossorigin />
    <link rel="preconnect" href="https://economia.awesomeapi.com.br" crossorigin />
    <link rel="preconnect" href="https://data-api.binance.vision" crossorigin />
    <title>{title}</title>
    <script is:inline>
      // aplica o tema antes da pintura para evitar flash
      try {
        var t = JSON.parse(localStorage.getItem('vantage:theme'));
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
